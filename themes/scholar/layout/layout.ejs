<% const section = page.section || 'home'; const a = site.data.archive; %>
<!doctype html><html lang="zh-CN"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= page.title || '首页' %> · <%= a.title %></title>
<meta name="description" content="董卿与周涛人物资料馆。循着年份，重访舞台、访谈与共同记忆。"><meta name="theme-color" content="#f8f5ed">
<link rel="icon" href="<%= url_for('/assets/favicon.svg') %>" type="image/svg+xml">
<link rel="stylesheet" href="<%= url_for('/css/main.css') %>"><script src="<%= url_for('/js/main.js') %>" defer></script>
</head><body data-page="<%= section %>">
<a class="skip-link" href="#main">跳至正文</a>
<header class="site-header"><div class="nav-shell">
<a class="brand" href="<%= url_for('/') %>"><img src="<%= url_for('/assets/favicon.svg') %>" width="38" height="38" alt=""><span>年年岁岁人依旧<small>DONG QING & ZHOU TAO ARCHIVE</small></span></a>
<button class="menu-toggle" aria-label="展开导航" aria-controls="navigation" aria-expanded="false">目录 <span>☰</span></button>
<nav id="navigation" aria-label="主导航"><% theme.navigation.forEach(n=>{ %><a href="<%= url_for(n.href) %>" <%- section===n.key?'aria-current="page"':'' %>><%= n.label %></a><% }) %></nav>
</div></header><div class="ambient-petals" aria-hidden="true"><i></i><i></i><i></i></div>
<main id="main" class="container"><%- body %></main>
<footer class="site-footer container"><div><span class="footer-title">花开有时，记忆长留。</span><p>董卿与周涛人物资料馆</p></div><div class="footer-links"><button type="button" data-open-credits>关于本站 / Credits</button><a href="https://docs.qq.com/sheet/DR1hoeUFDTXJGY2VU?tab=BB08J2" target="_blank" rel="noopener noreferrer">意见反馈 ↗</a><a href="<%= url_for('/together/') %>">重访共同记忆 ↗</a></div></footer>
<dialog class="image-dialog" aria-label="图片画廊"><div class="lightbox-shell"><button class="lightbox-close" type="button" data-lightbox-close aria-label="关闭图片"><span aria-hidden="true">╳</span></button><button class="lightbox-nav lightbox-prev" type="button" data-lightbox-prev aria-label="上一张">‹</button><figure><img alt=""><figcaption><span data-lightbox-count></span><b data-lightbox-caption></b></figcaption></figure><button class="lightbox-nav lightbox-next" type="button" data-lightbox-next aria-label="下一张">›</button></div></dialog>
<dialog class="credits-dialog" aria-labelledby="credits-title"><div class="credits-panel"><button type="button" class="credits-close" data-close-credits aria-label="关闭关于本站">╳</button><p class="eyebrow">ABOUT THIS ARCHIVE / CREDITS</p><h2 id="credits-title">关于本站</h2><p class="credits-lead">网站的策划、资料整理、文字编辑和技术实现由伙伴们共同完成。站内引用的图片、视频、节目资料及媒体内容主要来自公开网络，版权归原作者、原媒体机构及相关权利人所有，并尽量保留来源。</p><dl class="credits-grid"><div><dt>发起 / 总策划</dt><dd>扶桑 · 云生</dd></div><div><dt>主编 / 排版</dt><dd>有余 · 哈哈 · 云生</dd></div><div><dt>信息检索</dt><dd>有余 · Ctangy · 哈哈</dd></div><div><dt>信息整合</dt><dd>云生 · Y不高 · 睡个好觉</dd></div><div><dt>文案编辑</dt><dd>云生 · 扶桑</dd></div><div><dt>技术支持</dt><dd>木子 · 扶桑 · 胖桃</dd></div><div><dt>审核校对</dt><dd>扶桑 · 云生</dd></div><div class="credits-wide"><dt>执行编辑</dt><dd>有余 · 哈哈 · 云生 · 扶桑 · 薯片 · Ctangy · Y不高 · 铝热剂 · 胖桃 · 睡个好觉 · 大奔 · 木子</dd></div><div class="credits-wide"><dt>特别鸣谢</dt><dd>啊biu · 安风 · 小刺叽</dd></div></dl></div></dialog>
<div class="music-player" data-music-player><button type="button" aria-label="播放背景音乐" aria-pressed="false"><span class="music-disc" aria-hidden="true"><i></i></span><span class="music-copy"><b>背景音乐</b><small data-music-status>轻触播放</small></span></button><audio data-background-audio loop preload="metadata" src="<%= url_for('/assets/audio/placeholder.wav') %>"></audio></div>
<a class="feedback-fab" href="https://docs.qq.com/sheet/DR1hoeUFDTXJGY2VU?tab=BB08J2" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">✎</span><b>意见反馈</b></a>
<a class="back-top" href="#main" aria-label="回到顶部">↑</a>
</body></html>
