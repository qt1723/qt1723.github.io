<%
const section=page.section;
const all=site.data.timeline;
const labels={zhou:'周涛',dong:'董卿',together:'共同记录'};
const trimMark=text=>(text||'').replace(/^[🍑🍉🌺✨★]+\s*/,'').trim();
const titleFrom=text=>trimMark((text||'').split('\n')[0])||'影像记录';
const hasSummary=(item,key)=>item.summaries.some(summary=>summary.label===labels[key]);
let baseItems=all;
if(['zhou','dong','together'].includes(section))baseItems=all.filter(item=>hasSummary(item,section));
if(section==='moments')baseItems=all.filter(item=>item.tags.includes('moments'));
const items=baseItems.map(raw=>{
  if(section==='timeline'){
    const tags=[];
    if(hasSummary(raw,'zhou'))tags.push('zhou');
    if(hasSummary(raw,'dong'))tags.push('dong');
    if(hasSummary(raw,'together'))tags.push('together');
    if(raw.tags.includes('moments'))tags.push('moments');
    const first=raw.summaries[0];
    const fallbackTitle=/原表|核实|编者|对照/.test(raw.title)?'日期记录':raw.title;
    return {...raw,tags,title:first?titleFrom(first.text):(raw.observation?titleFrom(raw.observation):fallbackTitle)};
  }
  if(['zhou','dong','together'].includes(section)){
    const summary=raw.summaries.find(entry=>entry.label===labels[section]);
    return {...raw,tags:[],title:titleFrom(summary&&summary.text),summaries:summary?[{...summary,text:trimMark(summary.text)}]:[],observation:''};
  }
  return {...raw,tags:[],title:titleFrom(raw.observation),summaries:[]};
});
const headings={zhou:['ZHOU TAO','周涛','温润有声，从容向前。','主持人、制片人、导演、演员。从《综艺大观》到话剧《情书》，在不同舞台探索表达。'],dong:['DONG QING','董卿','以声为舟，以书为岸。','主持人、制作人。从《欢乐中国行》到《朗读者》，收藏声音里的力量与文字里的温度。'],together:['TOGETHER','共同记忆','在交汇的时光里。','同一方舞台，同一段旋律，按年份重访共同活动与珍藏瞬间。'],moments:['MOMENTS','名场面','把瞬间，再看一遍。','节目片段、舞台互动与镜头之外的动人细节。']};
const h=headings[section];
%>
<header class="page-heading <%= ['zhou','dong'].includes(section)?'profile-heading':'' %>"><div><p class="eyebrow"><%= h[0] %> / 人物资料馆</p><h1><%= h[1] %><% if(section==='zhou'){ %><span class="heading-icon heading-icon-zhou" aria-hidden="true"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 13C8 5 1 23 13 32c5 4 9 4 14 0 13-10 5-26-7-19Z" fill="#df997c"/><path d="M20 15c-4 4-5 10-3 16" fill="none" stroke="#b96c56" stroke-width="1.2"/><path d="M20 12c0-6 5-9 11-8-1 6-6 9-11 8" fill="#84967a"/></svg></span><% }else if(section==='dong'){ %><span class="heading-icon heading-icon-dong" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M20 6 36 29Q20 42 4 29Z" fill="#7e9474"/><path d="M20 6 33 28Q20 38 7 28Z" fill="#ede3c8"/><path d="M20 6 30 27Q20 34 10 27Z" fill="#d98976"/><path d="m20 16 .2 2m-5 5 .6 1.6m9.4-1.6-.6 1.6M20 27v1.5" stroke="#765e4d" stroke-width="1.6" stroke-linecap="round"/></svg></span><% }else if(section==='together'){ %><span class="heading-icon heading-icon-together" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><g stroke="#bc624d" stroke-width=".7"><path d="M24 24C12 17 16 3 23 5C32 5 32 17 24 24" fill="#e8a48b"/><path d="M24 24C25 10 39 9 42 16C44 24 32 28 24 24" fill="#cd7057"/><path d="M24 24C37 21 45 33 38 38C30 44 22 33 24 24" fill="#e19170"/><path d="M24 24C32 36 22 46 16 40C9 34 16 26 24 24" fill="#c5634c"/><path d="M24 24C12 33 2 23 7 16C13 10 21 16 24 24" fill="#e7b096"/></g><g stroke="#826540" stroke-linecap="round"><path d="M24 25L22 16M24 25L30 18M24 25L33 26M24 25L27 33M24 25L17 29M24 25L15 22"/></g><g fill="#a28143"><circle cx="22" cy="16" r="1.5"/><circle cx="30" cy="18" r="1.5"/><circle cx="33" cy="26" r="1.5"/><circle cx="27" cy="33" r="1.5"/><circle cx="17" cy="29" r="1.5"/><circle cx="15" cy="22" r="1.5"/></g></svg></span><% }else{ %><span class="heading-icon heading-icon-moments" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M23 5C25 18 29 21 39 24C28 26 24 30 21 42C20 30 16 26 5 23C17 21 20 17 23 5Z" fill="#d7aa50"/><path d="M23 5L21 24L5 23C17 21 20 17 23 5Z" fill="#efd29a"/><path d="M39 4L41 10L47 12L41 14L39 20L37 14L31 12L37 10Z" fill="#d57b65"/><path d="M40 32L41 36L45 37L41 39L40 43L38 39L34 37L38 36Z" fill="#8d9d81"/></svg></span><% } %></h1><h2><%= h[2] %></h2><p><%= h[3] %></p><% if(section==='zhou'||section==='dong'){ %><a class="text-link" href="<%= url_for('/interviews/') %>?person=<%= section %>">阅读她的访谈 <svg class="icon-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M4 4h8v8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></a><% } %></div><% if(section==='zhou'||section==='dong'){ %><img class="profile-photo" src="<%= url_for(section==='zhou'?'/assets/archive/image79.jpeg':'/assets/dong-qing-portrait.jpg') %>" alt="<%= h[1] %>人物配图"><% }else{ %><div class="page-number"><b>1968—2025</b><span><%= items.length %> 条馆藏记录</span></div><% } %></header>
<div class="archive-browser" data-archive data-section="<%= section %>">
<div class="browse-toolbar"><% if(section==='timeline'){ %><div class="filters" role="group" aria-label="人物筛选"><% [['all','全部'],['zhou','🍑 周涛'],['dong','🍉 董卿'],['together','🌺 共同'],['moments','✨ 名场面']].forEach(f=>{ %><button data-filter="<%= f[0] %>" aria-pressed="<%= f[0]==='all' %>"><%= f[1] %></button><% }) %></div><% } %><label class="search-box"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><input type="search" data-search-input placeholder="搜索节目、经历、关键词" aria-label="搜索资料"></label></div>
<div class="browse-meta"><span data-result-count aria-live="polite">共 <%= items.length %> 条记录</span><div><label>年代 <select data-era aria-label="选择年代"><option value="all">全部年代</option><option value="1968-1989">1968—1989</option><option value="1990-1999">1990—1999</option><option value="2000-2009">2000—2009</option><option value="2010-2019">2010—2019</option><option value="2020-2025">2020—2025</option><option value="unknown">年份未详</option></select></label><button class="reset" data-reset>重置筛选</button></div></div>
<div class="timeline-layout"><aside class="year-index"><p class="eyebrow">年份索引</p><div><% for(let y=1968;y<=2025;y++){ %><a href="#year-<%= y %>" data-year-jump="<%= y %>" class="<%= items.some(i=>i.year===y)?'has-records':'' %>"><%= y %></a><% } %><a href="#year-unknown" data-year-jump="unknown">未详</a></div><p class="index-note">深色年份有记录<br>点击年份快速定位</p></aside><div class="timeline-records">
<% [...Array.from({length:58},(_,i)=>1968+i),null].forEach(year=>{const group=items.filter(i=>i.year===year); %><section class="year-group" id="year-<%= year || 'unknown' %>" data-year-group="<%= year || 'unknown' %>"><header><h2><%= year || '年份未详' %></h2><span><%= group.length?group.length+' 条记录':'本年暂无收录' %></span></header><% group.forEach(item=>{ %><%- partial('_partial/record',{item,section}) %><% }) %></section><% }) %><p class="empty-state" data-empty hidden>没有找到匹配的记录。试试其他关键词，或重置筛选。</p>
</div></div></div>
