<%
const timelineWithImages=site.data.timeline.filter(row=>row.images&&row.images.length);
const interviewCover=item=>{
  if(item.images&&item.images.length)return item.images[0];
  const sameSource=timelineWithImages.find(row=>row.sources.some(source=>item.sources.some(candidate=>candidate.url===source.url)));
  if(sameSource)return sameSource.images[0];
  return null;
};
%>
<header class="page-heading"><div><p class="eyebrow">INTERVIEWS / 椒花颂声</p><h1>与君书<span class="heading-icon heading-icon-interviews" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="15" y="5" width="15" height="25" rx="7.5" fill="#e5b393"/><path d="M20 10H25M20 14H25M20 18H25M10 23C10 40 35 40 35 23M22.5 36V43M16 43H29" stroke="#6e826b" stroke-width="1.6" stroke-linecap="round"/><path d="M37 9Q44 17 38 24" stroke="#c78564" stroke-width="1.5" stroke-linecap="round"/></svg></span></h1><h2>见字如面，听见她们。</h2><p>访谈、讲座、文字与朗读。在只言片语里，走近人生的一隅。</p></div><div class="page-number"><b><%= site.data.interviews.length %></b><span>份访谈与延伸阅读</span></div></header>
<section data-interviews><div class="browse-toolbar"><div class="interview-tabs" role="tablist" aria-label="访谈人物"><% [['zhou','周涛'],['dong','董卿'],['together','共同访谈']].forEach((v,i)=>{ %><button id="tab-<%= v[0] %>" role="tab" aria-controls="panel-<%= v[0] %>" aria-selected="<%= i===0 %>" tabindex="<%= i===0?'0':'-1' %>" data-tab="<%= v[0] %>"><%= v[1] %><small><%= site.data.interviews.filter(x=>x.person===v[0]).length %></small></button><% }) %></div><label class="search-box"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><input type="search" data-interview-search placeholder="搜索访谈主题、年份" aria-label="搜索访谈"></label></div><div class="browse-meta"><span data-interview-count aria-live="polite"></span><p>视频优先呈现 · 文字资料可直达原文</p></div>
<% ['zhou','dong','together'].forEach(person=>{ %><section id="panel-<%= person %>" role="tabpanel" aria-labelledby="tab-<%= person %>" data-panel="<%= person %>" tabindex="0"><div class="interview-grid"><% site.data.interviews.filter(x=>x.person===person).forEach(item=>{const video=item.sources.find(s=>s.kind==='video');const first=video||item.sources[0];const cover=interviewCover(item);const variant=(Number((item.id.match(/\d+$/)||['0'])[0])+({zhou:0,dong:3,together:6}[person]||0))%9; %>
<article class="interview-item" id="<%= item.id %>" data-interview-item data-search="<%= item.title+' '+item.description+' '+item.date %>"><% if(first){ %><a class="interview-card-link" href="<%= safe_url(first.url) %>" target="_blank" rel="noopener noreferrer" aria-label="打开：<%= item.title %>"><span class="interview-cover <%= video?'has-video':'' %> <%= !cover&&!video?'is-book-cover':'' %>"><% if(cover){ %><img loading="lazy" src="<%= url_for(cover) %>" alt="<%= item.title %>封面"><% }else if(video){ %><img loading="lazy" src="<%= url_for('/assets/video-cover.svg') %>" alt="木棉影像手记，暂无原始封面"><% }else{ %><span class="book-cover-sprite book-variant-<%= variant %>" role="img" aria-label="书籍与木棉花主题封面"></span><% } %><% if(video){ %><span class="play-icon" aria-hidden="true">▶</span><% } %><span class="cover-label"><%= video?'播放视频':'阅读全文' %> <svg class="icon-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M4 4h8v8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></span></span><span class="interview-body"><span class="eyebrow"><%= item.date %> <i>· <%= video?'影像访谈':'文字 / 阅读' %></i></span><strong><%= item.title %></strong><span class="interview-desc"><%= item.description || (video?'打开影像，回到这一次对话。':'访谈与文字资料，可前往来源阅读完整内容。') %></span><em><%= video?'观看访谈':'阅读原文' %> <svg class="icon-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M4 4h8v8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></em></span></a><% } %></article>
<% }) %></div><% if(person==='dong'){ %><details class="longform-card"><summary><span class="longform-title"><b><%= site.data.archive.reading_title %></b></span><span class="read-cue">开始阅读 →</span></summary><div class="reading-text"><%= site.data.archive.reading %></div></details><% } %></section><% }) %><p class="empty-state" data-interview-empty hidden>没有找到相关访谈，请换一个关键词。</p><div class="pagination" data-pagination hidden><button data-prev>← 上一页</button><span data-page-label aria-live="polite"></span><button data-next>下一页 →</button></div></section>
