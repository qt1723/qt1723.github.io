<% const visibleSources=[...new Map(item.sources.filter(source=>source.kind!=='video').map(source=>[source.url,source])).values()]; %><% if(visibleSources.length){ %><div class="sources"><span>资料来源</span><% visibleSources.forEach(s=>{ %><a href="<%= safe_url(s.url) %>" target="_blank" rel="noopener noreferrer"><%= s.label %> <svg class="icon-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M4 4h8v8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></a><% }) %></div><% } %>
