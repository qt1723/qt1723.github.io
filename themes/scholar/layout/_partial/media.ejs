<% const videos=item.sources.filter(s=>s.kind==='video'); const poster=item.images[0]; %>
<% if(videos.length){ %><div class="media-list"><% videos.forEach((v,index)=>{ %><a class="video-card" href="<%= safe_url(v.url) %>" target="_blank" rel="noopener noreferrer" aria-label="在原网站播放：<%= item.title %>，视频<%= index+1 %>"><img loading="lazy" src="<%= url_for(poster || '/assets/video-cover.svg') %>" alt="<%= item.title %>视频封面"><span class="play-icon" aria-hidden="true">▶</span><span class="video-caption"><b>播放视频 <%= videos.length>1?index+1:'' %> <svg class="icon-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M4 4h8v8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></b><small><%= v.label %> · 在原网站观看</small></span></a><% }) %></div><% } %>
<% if(item.images.length){ %><div class="image-gallery"><% item.images.forEach((img,index)=>{ %><a class="image-card" href="<%= url_for(img) %>" data-lightbox data-caption="图片 <%= index+1 %> / <%= item.images.length %>"><img loading="lazy" src="<%= url_for(img) %>" alt="<%= item.title %>配图 <%= index+1 %>"></a><% }) %></div><% } %>
